<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>whisker_amr_sim</name>
  <version>0.1.0</version>
  <description>MuJoCo simulation of a differential-drive AMR with LiDAR, camera and rat-whisker-inspired tactile sensors, bridged to ROS 2.</description>
  <maintainer email="gargidas694@gmail.com">Gargi Das</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>ament_index_cpp</depend>
  <depend>mujoco_vendor</depend>

  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_lint_common</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
